{
  "breakpoints": [375, 768, 1280, 1440],
  "out": "./src/bones",
  "routes": [
    "/plantilla",
    "/plantilla?view=empleados",
    "/candidatos",
    "/bajas",
    "/resumen",
    "/reportes",
    "/configuracion?tab=busqueda",
    "/configuracion?tab=indicadores",
    "/configuracion?tab=rutas",
    "/configuracion?tab=rutas&view=incidencias",
    "/configuracion?tab=tabulador",
    "/configuracion?tab=speech",
    "/configuracion?tab=formatos",
    "/configuracion?tab=sistema"
  ],
  "wait": 2200,
  "color": "var(--color-canvas-soft)",
  "darkColor": "var(--color-canvas-soft)",
  "shimmerColor": "color-mix(in srgb, var(--color-ink) 8%, var(--color-canvas-soft))",
  "darkShimmerColor": "color-mix(in srgb, var(--color-ink) 8%, var(--color-canvas-soft))",
  "animate": "shimmer",
  "speed": "var(--duration-skeleton)",
  "boneClass": "boneyard-skeleton__bone"
}
